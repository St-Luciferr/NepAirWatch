# NepAirWatch — copy to .env and adjust:   cp .env.example .env
# docker compose reads .env automatically. Every value below is optional; the defaults are shown.

# ---------------------------------------------------------------- history loaded on the first start
# Open-Meteo CAMS air quality + weather, days of history (15 cities, hourly)
BACKFILL_DAYS=365
# DoEnv Nepal stations + Sensor.Community, days of 1-minute history
# (the DoEnv API only keeps ~3 weeks, so values above ~20 add nothing for DoEnv)
GROUND_BACKFILL_DAYS=20
# NASA FIRMS fire hotspots, days of history. Without FIRMS_MAP_KEY at most 7 days are available.
FIRMS_BACKFILL_DAYS=7
# First year of NASA POWER aerosol / climate history (available from 2001)
POWER_START_YEAR=2001

# ---------------------------------------------------------------- API keys
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ — unlocks fire history beyond 7 days
FIRMS_MAP_KEY=

# ---------------------------------------------------------------- live polling intervals (seconds)
# Open-Meteo
LIVE_INTERVAL=900
# DoEnv + Sensor.Community
GROUND_INTERVAL=600
# NASA FIRMS (files refresh every ~3 h)
FIRMS_INTERVAL=10800
# Google News RSS
NEWS_INTERVAL=1800

# ---------------------------------------------------------------- batch schedules (seconds)
# Spark batch layer (batch_analytics + fusion_analytics)
BATCH_INTERVAL=21600
# Hadoop MapReduce job (profile mapreduce / full)
MR_INTERVAL=86400

# ---------------------------------------------------------------- demo replay (docker compose run --rm replay)
REPLAY_DAYS=2
REPLAY_SPEED=2

# ---------------------------------------------------------------- optional components
# Start YARN/MapReduce and/or Hive without passing --profile every time: mapreduce, hive or full
# COMPOSE_PROFILES=full
