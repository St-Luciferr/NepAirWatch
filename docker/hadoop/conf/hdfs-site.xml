<?xml version="1.0"?>
<configuration>
  <!-- single DataNode demo cluster; production: >= 3 DataNodes and replication 3 -->
  <property><name>dfs.replication</name><value>1</value></property>
  <property><name>dfs.namenode.name.dir</name><value>file:///hadoop/dfs/name</value></property>
  <property><name>dfs.datanode.data.dir</name><value>file:///hadoop/dfs/data</value></property>
  <property><name>dfs.namenode.rpc-bind-host</name><value>0.0.0.0</value></property>
  <property><name>dfs.namenode.http-address</name><value>0.0.0.0:9870</value></property>
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
  <property><name>dfs.webhdfs.enabled</name><value>true</value></property>
  <!-- several services (Spark as root, Hive as hive, Flume) share the lake in this demo -->
  <property><name>dfs.permissions.enabled</name><value>false</value></property>
  <property><name>dfs.namenode.safemode.extension</name><value>5000</value></property>
</configuration>
